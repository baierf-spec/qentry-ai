{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qentry",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qentry",
      // Replace with the id printed by `npx wrangler d1 create qentry`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "QUEUE", "class_name": "QueueRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueueRoom"] }],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "APP_URL": "https://qentry.ai",
    "ADMIN_EMAILS": "baier.f@gmail.com"
  },
  "observability": { "enabled": true }
  // Secrets (set with `npx wrangler secret put NAME`):
  //   ANTHROPIC_API_KEY  – powers the AI setup chat and translations
}
